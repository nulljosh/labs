    "Keep this tab open. A closed tab cannot ring.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ هذه الصفحة مفتوحة. الصفحة المغلقة لا ترن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass diesen Tab offen. Ein geschlossener Tab kann nicht klingeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja esta pestaña abierta. Una pestaña cerrada no puede sonar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez cet onglet ouvert. Un onglet fermé ne peut pas sonner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टैब खुला रखें। बंद टैब नहीं बज सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni aperta questa scheda. Una scheda chiusa non suona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブを開いたままにしてください。閉じたタブは鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 탭을 열어 두세요. 닫힌 탭은 울리지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat dit tabblad open. Een gesloten tabblad kan niet afgaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha esta aba aberta. Uma aba fechada não toca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持此标签页打开，关闭后无法响铃。"
          }
        }
      }
    },
