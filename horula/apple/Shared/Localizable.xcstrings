    "Alarms are turned off for Horula in Settings, so they cannot ring.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منبهات Horula متوقفة في الإعدادات، لذا لا يمكنها أن ترن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker für Horula sind in den Einstellungen aus und können nicht klingeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas de Horula están desactivadas en Ajustes, así que no pueden sonar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes de Horula sont désactivées dans Réglages, elles ne peuvent donc pas sonner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में Horula के अलार्म बंद हैं, इसलिए वे बज नहीं सकते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sveglie di Horula sono disattivate in Impostazioni, quindi non possono suonare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でHorulaのアラームがオフになっているため、鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Horula 알람이 꺼져 있어 울릴 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wekkers voor Horula staan uit in Instellingen, dus ze kunnen niet afgaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alarmes do Horula estão desativados em Ajustes, então não podem tocar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Horula 的闹钟已在设置中关闭，因此无法响铃。"
          }
        }
      }
    },
    "Alarms ring while this page is open. Add it to your Home Screen to keep it handy.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترن المنبهات ما دامت هذه الصفحة مفتوحة. أضفها إلى الشاشة الرئيسية لتبقى في متناولك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker klingeln, solange diese Seite offen ist. Leg sie auf den Home-Bildschirm, dann ist sie griffbereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas suenan mientras esta página está abierta. Añádela a la pantalla de inicio para tenerla a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes sonnent tant que cette page est ouverte. Ajoutez-la à l’écran d’accueil pour l’avoir sous la main."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पेज खुला रहने तक अलार्म बजते हैं। इसे होम स्क्रीन पर जोड़ लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sveglie suonano finché questa pagina è aperta. Aggiungila alla schermata Home per averla a portata di mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームはこのページを開いている間に鳴ります。ホーム画面に追加しておくと便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지가 열려 있는 동안 알람이 울립니다. 홈 화면에 추가해 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wekkers gaan af zolang deze pagina open is. Zet hem op je beginscherm, dan heb je hem bij de hand."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alarmes tocam enquanto esta página estiver aberta. Adicione-a à tela de início para tê-la à mão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面打开时闹钟才会响。添加到主屏幕，随时可用。"
          }
        }
      }
    },
