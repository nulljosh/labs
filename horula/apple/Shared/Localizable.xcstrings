    "Everything stays on this device. No account, no tracking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبقى على هذا الجهاز. بلا حساب ولا تتبع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Gerät. Kein Konto, kein Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este dispositivo. Sin cuenta ni rastreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet appareil. Pas de compte, pas de pistage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ इसी डिवाइस पर रहता है। न खाता, न ट्रैकिंग।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo dispositivo. Nessun account, nessun tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこのデバイスに残ります。アカウントも追跡もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터는 이 기기에만 있습니다. 계정도 추적도 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft op dit apparaat. Geen account, geen tracking."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste aparelho. Sem conta, sem rastreamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都留在本设备。无需账户，不追踪。"
          }
        }
      }
    },
    "Export": {
      "localizations": {
