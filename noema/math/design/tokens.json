{
  "name": "Noema",
  "version": "1.0",
  "source": "https://clrs.cc",
  "colors": {
    "navy": "#001F3F",
    "blue": "#0074D9",
    "aqua": "#7FDBFF",
    "black": "#111111",
    "gray": "#AAAAAA",
    "silver": "#DDDDDD",
    "white": "#FFFFFF",
    "maroon": "#85144B",
    "olive": "#3D9970"
  },
  "type": {
    "display": "Georgia, Times New Roman, serif",
    "body": "system-ui, sans-serif",
    "minimum_body_px": 14,
    "minimum_supporting_px": 12
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius_px": {
    "control": 4,
    "panel": 8
  },
  "logo": {
    "grid": 64,
    "clear_space": 8,
    "minimum_symbol_px": 24,
    "small_symbol_px": 16,
    "colors_per_mark": 1
  },
  "rules": [
    "Never use gray or silver as text on white.",
    "Use navy on aqua; use white on navy or blue.",
    "Always pair color-coded results with words.",
    "Use the simplified mark at 16\u201323px."
  ]
}
